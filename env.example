# Copy to .env (never committed). backend/app/config.py reads these; defaults in brackets.
# The model runs locally only (Ollama). No hosted model APIs in the product (task pt 5).

# Upload limit in MB [10]
MAX_FILE_SIZE_MB=10

# JWT on the API [false]; the secret is given only at runtime
JWT_ENABLED=false
JWT_SECRET=
JWT_ALGORITHM=HS256

# Local model server, OpenAI-compatible. In docker compose: http://ollama:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:4b
LLM_API_KEY=ollama
LLM_TIMEOUT_S=120
# Path to a FormAnalysis JSON; when set, llm.py returns it and never calls the model (tests)
LLM_FIXTURE=

OCR_LANG=pol
ADD_VALIDATORS=true
