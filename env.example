# Copy to .env (never committed). backend/app/config.py reads these; defaults in brackets.
# Ollama runs locally by default. D9 allows open-weight models via the organizers' Eden AI.

# Upload limit in MB [10]
MAX_FILE_SIZE_MB=10

# JWT on POST /api/forms [false]; /health stays open. Secret given only at runtime,
# at least 32/48/64 bytes for HS256/HS384/HS512. Token: python -m app.auth token
JWT_ENABLED=false
JWT_SECRET=
JWT_ALGORITHM=HS256

# OpenAI-compatible model server. Leave empty: docker compose uses http://ollama:11434/v1,
# a local run (uvicorn from backend/.venv) uses http://localhost:11434/v1.
LLM_BASE_URL=
LLM_MODEL=qwen3.5:4b
LLM_API_KEY=ollama
LLM_TIMEOUT_S=120
LLM_CONNECT_TIMEOUT_S=
# Model context in tokens [32768], min. 8192. The same value goes to the ollama service in compose,
# so the server and the analysis budget agree. Cloud models usually allow more (Qwen3.5-9B: 262144).
LLM_CONTEXT_TOKENS=32768
# Response limit in tokens [4096 for Ollama, 8192 for Eden AI]
LLM_MAX_TOKENS=
# Temperature [0] and reasoning effort [none]. Set either to off to omit it from the request.
LLM_TEMPERATURE=
LLM_REASONING_EFFORT=
# Strict JSON schema [true]. Optional JSON object for additional request parameters.
LLM_STRICT_SCHEMA=
LLM_EXTRA_BODY=
# Path to a FormAnalysis JSON; when set, llm.py returns it and never calls the model (tests)
LLM_FIXTURE=

OCR_LANG=pol
ADD_VALIDATORS=true
